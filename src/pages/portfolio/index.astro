---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Button from "../../components/Button.astro";
import CaseStudyCard from "./_components/CaseStudyCard.astro";
import TechUsage from "./_components/TechUsage.astro";
import "../../styles/markdown.css";
import { Content as Intro } from "./_content/intro.md";
import { Content as Experience } from "./_content/experience.md";
import { caseStudies } from "./_data/case-studies";

import DailySelfTrackScreenshots from "../../assets/images/portfolio/DailySelfTrack-Main-Screenshots.png";
---

<BaseLayout
    title="Portfolio - Bryan Hogan"
    description="Bryan Hogan designs and builds digital products, from user research to shipped code. Case studies of DailySelfTrack and Sorbit, and the tech behind them."
>
    <Hero heading="Portfolio" headingDetail="Work and experience by Bryan Hogan" />

    <div class="markdown-container margin-top-xl margin-inline-auto">
        <Intro />
    </div>
    <div class="intro-actions margin-inline-auto">
        <div class="cta-row">
            <Button href="mailto:bryan@bryanhogan.com" size="medium" iconLeft="email">Email</Button>
            <Button href="https://www.linkedin.com/in/bryanhoganme/" variant="secondary" size="medium" target="_blank" iconLeft="linkedin">LinkedIn</Button>
        </div>
        <p class="aside">
            Just here for my projects or writing instead? See my <a href="/projects">projects</a> and <a href="/blog">blog</a>.
        </p>
    </div>

    <section class="wide-section margin-top-2xl margin-inline-auto">
        <h2>Case studies</h2>
        <div class="case-study-list">
            <CaseStudyCard
                {...caseStudies.dailyselftrack}
                image={DailySelfTrackScreenshots}
                imageAlt="DailySelfTrack screenshots showing three different views on a vibrant gradient background"
            />
            <CaseStudyCard {...caseStudies.sorbit}>
                <svg slot="visual" viewBox="0 0 200 200" role="img" aria-label="Simple orbit graphic: a center dot surrounded by three rings with small dots on them">
                    <g fill="none" style="stroke: var(--color-neutral-500)" stroke-width="1.5">
                        <circle cx="100" cy="100" r="30" />
                        <circle cx="100" cy="100" r="55" />
                        <circle cx="100" cy="100" r="80" />
                    </g>
                    <circle cx="100" cy="100" r="14" style="fill: var(--color-accent-500)" />
                    <g style="fill: var(--color-accent-200)">
                        <circle cx="119.3" cy="77" r="6" />
                        <circle cx="48.3" cy="118.8" r="5" />
                        <circle cx="151.7" cy="118.8" r="5" />
                        <circle cx="60" cy="30.7" r="4" />
                        <circle cx="140" cy="169.3" r="4" />
                    </g>
                </svg>
            </CaseStudyCard>
        </div>
    </section>

    <section class="wide-section margin-top-2xl margin-inline-auto">
        <h2>Skills and tools</h2>
        <p class="section-intro">Select one to see how and where I've used it.</p>
        <TechUsage />
    </section>

    <div class="markdown-container margin-top-2xl margin-bottom-xl margin-inline-auto">
        <Experience />
    </div>
</BaseLayout>

<style>
    .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-s);
    }
    .intro-actions {
        width: 100%;
        max-width: min(100%, var(--main-content-max-width));
        margin-top: var(--space-m);
    }
    .aside {
        margin-top: var(--space-s);
        font-size: var(--font-size-small);
        color: var(--color-neutral-300);
        & a {
            font-size: inherit;
            color: var(--a-hover-color);
        }
    }
    .wide-section {
        max-width: 64rem;
        width: 100%;
        & h2 {
            margin-bottom: var(--space-m);
        }
    }
    .section-intro {
        color: var(--color-neutral-300);
        margin-top: calc(var(--space-s) * -1);
        margin-bottom: var(--space-m);
    }
    .case-study-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
    }
</style>
