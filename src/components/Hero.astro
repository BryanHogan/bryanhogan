---
interface Props {
    heading: string;
    headingDetail: string;
    height?: string;
}
const { heading, headingDetail, height="20svh" } = Astro.props;
---

<div class="hero full-width">
    <h1>
        <span>{heading}</span>
        {" "}
        <span class="heading-detail">{headingDetail}</span>
    </h1>
    <slot />
</div>

<style define:vars={{ height }}>
    .hero {
        background-color: var(--color-accent-500);
        background-image: var(--color-gradient);
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: var(--height);
        padding-block: var(--space-l);
        padding-inline: var(--side-gap-padding);
        gap: var(--space-s);
        & :global(p), h1 {
            color: var(--color-neutral-50);
            text-shadow: var(--text-shadow-m);
        }
    }

    h1 {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: var(--space-s);
        text-align: center;
        text-wrap: balance;

        .heading-detail {
            font-size: 1rem;
            font-weight: var(--font-weight-regular);
            line-height: var(--font-line-height);
            max-width: var(--main-content-max-width);
            text-wrap: pretty;
        }
    }
</style>
