---
import { Icons } from "./Icons";
import Icon from "./Icon.astro";
---

<div class="backdrop-area">
    <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
    <div class="header-container">
        <header>
            <ul role="list" class="left-content-container">
                <li>
                    <a href="/" class="logo-a" aria-label="Bryan Hogan logo - Click to go back to the home page" title="Go back to home page"
                        ><svg
                            class="logo"
                            width="28"
                            height="28"
                            viewBox="0 0 16 16"
                            fill="currentColor"
                            set:html={Icons["logogrey"]}
                        /></a>
                </li>
                <li><a href="/blog">Blog</a></li>
                <li><a href="/follow">Follow</a></li>
            </ul>

            <button
                aria-controls="primary-navigation"
                aria-expanded="false"
                aria-label="Navigation menu"
                class="menu-toggle-button"
            >
                <Icon
                    name="bars"
                    size="1.5rem"
                    class="hamburger-icon"
                    color="var(--color-neutral-300)"
                />
                <Icon
                    name="close"
                    size="1.5rem"
                    class="close-icon"
                    color="var(--color-neutral-300)"
                />
            </button>
            <nav id="primary-navigation" class="primary-navigation">
                <ul role="list">
                    <li><a href="/projects">Projects</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/now">Now</a></li>
                    <li><a href="/socials">Socials</a></li>
                </ul>
            </nav>
        </header>
    </div>
</div>

<style>
    .backdrop-area {
        width: 100%;
        height: var(--navbar-height);
    }
    .header-container {
        width: 100%;
        position: fixed;
        z-index: 20;
        background-color: var(--color-neutral-900);
        background-color: color-mix(
            in srgb,
            var(--color-neutral-900) 95%,
            transparent
        );
    }
    .header-container::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        backdrop-filter: blur(5px);
        z-index: -1;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-inline: auto;
        padding-inline: var(--side-gap-padding);
        height: var(--navbar-height);
        overflow: hidden;
    }


    .primary-navigation ul, .left-content-container {
        display: flex;
        align-items: center;
        gap: calc(var(--space-m) - 4px);
        &>li>a {
            color: var(--color-neutral-300);
            text-decoration: none;
            padding: 2px;
            transition: var(--transition-normal) color;
            &:hover,
            &:focus-within {
                color: var(--a-hover-color);
            }
        }
    }
    .menu-toggle-button {
        display: none;
    }

    .nav-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: hsl(0 0 0 / 0.7);
        z-index: 15;
    }

    .nav-backdrop.is-open {
        display: block;
    }

    @media only screen and (max-width: 35.999rem) {
        .primary-navigation ul {
            display: none;
        }
        .menu-toggle-button {
            display: block;
            position: absolute;
            z-index: 30;
            right: 1rem;
            background-color: transparent;
            padding: 0.5rem 0.5rem 0.5rem 0.5rem;
            margin-right: -0.5rem;
            border: 0;
            cursor: pointer;
            }
        .menu-toggle-button :global(.close-icon) {
            display: none;
        }
        .menu-toggle-button[aria-expanded="true"] :global(.close-icon) {
            display: block;
        }
        .menu-toggle-button[aria-expanded="true"] :global(.hamburger-icon) {
            display: none;
        }
        .menu-toggle-button[aria-expanded="true"] ~ nav {
            display: block;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: 80%;
            margin-left: auto;
            background-color: var(--color-neutral-900);
            z-index: 20;
            ul {
                margin-top: 20vh;
                display: grid;
                gap: 2rem;
                margin-left: max(3rem, 20vw);
            }
        }
    }
</style>

<script>
    let navigationController: AbortController | undefined;

    function setupNavigation() {
        navigationController?.abort();

        const navigationToggle = document.querySelector(
            '[aria-controls="primary-navigation"]',
        ) as HTMLButtonElement | null;
        const navigation = document.querySelector(
            ".primary-navigation",
        ) as HTMLElement | null;
        const backdrop = document.getElementById(
            "nav-backdrop",
        ) as HTMLElement | null;

        if (!navigationToggle || !navigation) return;

        navigationController = new AbortController();

        const closeMenu = (event: Event) => {
            if (navigation.contains(event.target as Node)) return;
            navigationToggle.setAttribute("aria-expanded", "false");
            backdrop?.classList.remove("is-open");
        };

        const toggleMenu = (event: Event) => {
            event.stopPropagation();
            const navigationOpened =
                navigationToggle.getAttribute("aria-expanded");
            const isOpening = navigationOpened === "false";
            navigationToggle.setAttribute(
                "aria-expanded",
                isOpening ? "true" : "false",
            );
            if (isOpening) {
                backdrop?.classList.add("is-open");
            } else {
                backdrop?.classList.remove("is-open");
            }
        };

        navigationToggle.addEventListener("click", toggleMenu, {
            signal: navigationController.signal,
        });
        document.addEventListener("click", closeMenu, {
            signal: navigationController.signal,
        });
    }

    setupNavigation();

    document.addEventListener("astro:after-swap", setupNavigation);
</script>
