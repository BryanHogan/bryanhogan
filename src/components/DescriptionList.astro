---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<ul role="list" class:list={["description-list", className]}>
    <slot />
</ul>

<style>
    .description-list {
        margin: 0 calc(var(--description-list-inset, 0px) * -1);
        padding: 0;
        list-style: none;
    }
</style>
