---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import "../styles/markdown.css";
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import { Icons } from "../components/Icons";
import EmailSignup from "../components/EmailSignup.astro";
import CardMin from "../components/CardMin.astro";
import CardGrid from "../components/CardGrid.astro";
import CardBlog from "../components/CardBlog.astro";
import TableOfContentsList from "../components/toc/TableOfContentsList.astro";
import { generateToC } from "../components/toc/generateToC";
import { getLastModifiedDate } from "../utils/last-update";
import { cardBlogBackgroundColors } from "../data/colors";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import DescriptionList from "../components/DescriptionList.astro";
import DescriptionListItem from "../components/DescriptionListItem.astro";
import BryanHoganImage from "../assets/images/Bryan-Hogan.png";
import featuredPosts from "../data/featured-posts";

interface Props {
    post: CollectionEntry<"blog">;
}
const { post } = Astro.props;

const allPosts: CollectionEntry<"blog">[] = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const indexOfPost = allPosts.findIndex(
    (posts) => posts.id === post.id,
);
const currentPostTags = new Set(post.data.tags);
const sameTagPosts = allPosts.filter(
    (candidatePost) =>
        candidatePost.id !== post.id &&
        candidatePost.data.tags.some((tag) => currentPostTags.has(tag)),
);
const mostRecentPost = allPosts.find(
    (candidatePost) => candidatePost.id !== post.id,
);
const featuredBlogPosts = featuredPosts
    .map((postId) => allPosts.find((candidatePost) => candidatePost.id === postId))
    .filter((candidatePost): candidatePost is CollectionEntry<"blog"> =>
        candidatePost !== undefined && candidatePost.id !== post.id
    );
const recommendationCandidates: CollectionEntry<"blog">[] = [
    ...sameTagPosts,
    ...(mostRecentPost ? [mostRecentPost] : []),
    ...featuredBlogPosts,
];
const recommendedPosts = [
    ...new Map(
        recommendationCandidates.map((candidatePost) => [candidatePost.id, candidatePost]),
    ).values(),
];
const { headings } = await render(post);
const hasSocialRefs = Boolean(post.data.blueskyRef || post.data.mastodonRef || post.data.threadsRef);


const lastUpdate = await (post.data.lastUpdate || getLastModifiedDate(`src/content/blog/${post.id}.md`));
---

<BaseLayout 
    title={post.data.title} 
    description={post.data.description} 
    ogType="article"
    markdownHref={`/blog/${post.id}.md`}
    ogImage={new URL(`/og/blog/${post.id}.png`, Astro.site).href}
    ogImageAlt={`${post.data.title} — BryanHogan.com`}
    articlePublished={post.data.pubDate}
    articleModified={lastUpdate}
    articleTags={post.data.tags}
>
    <div class="gradient-background flex-center full-width">
        {
            post.data.coverImage &&
            <Image
                src={post.data.coverImage as ImageMetadata}
                alt={post.data.title + " cover image icon"}
                transition:name={post.id}
            />
        }
        {post.data.emoji && !post.data.coverImage && <div class="flex-center"><p class="text-align-center emoji" transition:name={post.id} style="font-size: 4rem;">{post.data.emoji}</p></div>}
    </div>
    <div class="sub-menu-container full-width">
        <button type="button" onclick="history.back()" class="back-button" aria-label="Go back">
            <svg
                aria-hidden="true"
                class="arrow-back"
                width="28"
                height="28"
                viewBox="0 0 22 22"
                fill="currentColor"
                set:html={Icons["leftarrow"]}
            />
        </button>
    </div>
    <h1 id="_top" class="text-align-center margin-bottom-m margin-top-s">{post.data.title}</h1>
    <div class="content-and-toc margin-bottom-xl">
        <div class="main-container">
            <main class="markdown-container main-content">
                <slot />
            </main>

            <div class="end-of-post-container">
                <div class="author-section">
                    <div class="author-header">
                        <Image
                            class="author-image"
                            src={BryanHoganImage}
                            alt="Bryan Hogan in a classic polaroid style"
                            width={237}
                            height={234}
                        />
                        <div class="author-section-text-area">
                            <h2>Bryan Hogan</h2>
                            <p>Developer, designer, builder.</p>
                        </div>
                    </div>
                    <div class="author-description">
                        <p>I write about what I learn, build, and find interesting. Combining expertise in development, design and entrepreneurship.</p>
                        <p>Building <a href="https://dailyselftrack.com/" target="_blank">DailySelfTrack</a> and other <a href="/projects">useful things</a>.</p>
                    </div>
                </div>
                <DescriptionList>
                    <DescriptionListItem label={hasSocialRefs ? "Comment & share" : "Read more"}>
                        {hasSocialRefs ? (
                            <p>Comment, like and share on{" "}
                                {[
                                    post.data.blueskyRef && <a class="social-link" href={post.data.blueskyRef} target="_blank"><span class="social-icon"><Icon name="bluesky" size="1rem" label="Bluesky"/></span>Bluesky</a>,
                                    post.data.mastodonRef && <a class="social-link" href={post.data.mastodonRef} target="_blank"><span class="social-icon"><Icon name="mastodon" size="1rem" label="Mastodon"/></span>Mastodon</a>,
                                    post.data.threadsRef && <a class="social-link" href={post.data.threadsRef} target="_blank"><span class="social-icon"><Icon name="threads" size="1rem" label="Threads"/></span>Threads</a>,
                                ].filter(Boolean).map((link, i, arr) => (
                                    <Fragment>
                                        {i > 0 && i < arr.length - 1 && ", "}
                                        {i > 0 && i === arr.length - 1 && " or "}
                                        {link}{i === arr.length - 1 && "."}
                                    </Fragment>
                                ))}
                            </p>
                        ) : (
                            <p>Check out my <a href="/blog/introduction/">blog introduction</a> for more things I write about.</p>
                        )}
                    </DescriptionListItem>
                    {post.data.tags.length > 0 && (
                        <DescriptionListItem label="Tags">
                            <ul role="list" class="tag-list">
                                {post.data.tags.map((tag) => {
                                    const slug = tag.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9\-]/g, "");
                                    return <li><Button href={`/tags/${slug}`} text={tag} buttonStyle="line small" style="color: var(--color-neutral-200)" /></li>;
                                })}
                            </ul>
                        </DescriptionListItem>
                    )}
                    <DescriptionListItem label="Support me">
                        <p>If my writing helped you, consider <a href="https://github.com/sponsors/BryanHogan" target="_blank">supporting me as a GitHub sponsor</a>.</p>
                    </DescriptionListItem>
                    <DescriptionListItem label="Feedback">
                        <p>I'm always looking for feedback. Contact <a href="/socials">my socials</a> or <a href="https://forms.bryanhogan.com/b8qx" target="_blank">give feedback on my forms page</a>.</p>
                    </DescriptionListItem>
                    <DescriptionListItem label="Newsletter">
                        <p>Once a month I write about what I've been up to, what I built, and cool things I came across.</p>
                        <EmailSignup class="compact"/>
                    </DescriptionListItem>
                </DescriptionList>
                {(allPosts[indexOfPost - 1] || allPosts[indexOfPost + 1]) && (
                    <div class="post-nav-container">
                        {allPosts[indexOfPost - 1] && (
                            <a class="post-nav-link" href={`/blog/${allPosts[indexOfPost - 1].id}/`}>
                                <p class="nav-label">Next post</p>
                                <p class="nav-title">{allPosts[indexOfPost - 1].data.title}</p>
                            </a>
                        )}
                        {allPosts[indexOfPost + 1] && (
                            <a class="post-nav-link post-nav-prev" href={`/blog/${allPosts[indexOfPost + 1].id}/`}>
                                <p class="nav-label">Previous post</p>
                                <p class="nav-title">{allPosts[indexOfPost + 1].data.title}</p>
                            </a>
                        )}
                    </div>
                )}
            </div>
            <p class="publication-dates">
                <span>Published: <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-GB")}</time></span>
                {lastUpdate && (
                    <>
                        <span class="date-separator" aria-hidden="true">|</span>
                        <span>Last updated: <time datetime={lastUpdate.toISOString()}>{lastUpdate.toLocaleDateString("en-GB")}</time></span>
                    </>
                )}
            </p>
            {recommendedPosts.length > 0 && (
                <section class="related-posts markdown-container margin-top-xl" aria-labelledby="related-posts-heading">
                    <p id="related-posts-heading" class="margin-bottom-s" style="color: var(--color-neutral-200)"><strong>You might also enjoy</strong></p>
                    <ul>
                        {recommendedPosts.map((recommendedPost) => (
                            <li>
                                <a href={`/blog/${recommendedPost.id}/`}>{recommendedPost.data.title}</a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

        </div>
        <aside class="aside-container-right">
            <div class="toc">
                <div class="sticky-element">
                    <button class="toc-icon" aria-expanded="false" aria-controls="toc-items" aria-label="Table of contents">
                        <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            set:html={Icons["rightcaret"]}
                        />
                    </button>
                    <nav id="toc-items" class="toc-items" aria-label="Table of contents">
                        <p><strong>Table of Contents</strong></p>
                        <TableOfContentsList
                            toc={generateToC(headings, {
                                minHeadingLevel: 1,
                                maxHeadingLevel: 6,
                                title: post.data.title,
                            })}
                        />
                    </nav>
                </div>
            </div>
        </aside>
    </div>
        
</BaseLayout>

<style>
    .main-container {
        width: 100%;
        max-width: var(--main-content-max-width);
    }
    .content-and-toc {
        display: flex;
        flex-direction: row;
        justify-content: center;
    }
    .gradient-background {
        background-color: var(--color-accent-500);
        background-image: var(--color-gradient);
        min-height: 25svh;
        >* {
            height: 11rem;
            padding-block: var(--space-l);
            width: auto;
        }
    }
    .emoji {
        background-color: var(--color-neutral-100);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .end-of-post-container {
        background-color: var(--color-neutral-800);
        border: 1px solid var(--color-neutral-700);
        border-radius: var(--border-radius-m);
        padding: var(--space-m);
        --description-list-inset: var(--space-m);
        margin-top: var(--space-xl);

        display: flex;
        flex-direction: column;
        gap: var(--space-m);

        p {
            color: var(--color-neutral-200);
        }

        :global(.description-list:has(+ .post-nav-container)) {
            border-bottom: var(--border-width-s) solid var(--color-neutral-700);
        }

        h2 {
            font-size: var(--text-size-2xl);
            margin-bottom: var(--space-2xs);
        }

        .author-section {
            display: flex;
            flex-direction: column;
            gap: var(--space-m);

            .author-header {
                display: flex;
                flex-direction: row;
                align-items: center;
                gap: var(--space-m);

                .author-image {
                    width: 4rem;
                    height: auto;
                    border-radius: 50%;
                }
            }

            .author-description {
                display: flex;
                flex-direction: column;
                gap: var(--space-s);
            }
        }

        .social-link {
            display: inline;
            white-space: nowrap;
            color: var(--color-neutral-200);
            text-decoration: underline;
            transition: color var(--transition-normal);

            &:hover {
                color: var(--color-accent-500);
            }

            .social-icon {
                display: inline-block;
                transform: translateY(0.125em);
                margin-right: 0.2em;
            }
        }

        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2xs);
            list-style: none;
            padding: 0;
            margin: 0;
            text-transform: capitalize;
        }

        .post-nav-container {
            display: flex;
            border: 1px solid var(--color-neutral-600);
            border-radius: var(--border-radius-m);
            overflow: hidden;
            background-color: var(--color-neutral-900);

            .post-nav-link {
                flex: 1;
                padding: var(--space-m);
                text-decoration: none;
                transition: background-color var(--transition-normal);

                &:hover {
                    background-color: var(--color-neutral-800);
                }

                .nav-label {
                    color: var(--color-accent-500);
                    text-transform: uppercase;
                    font-weight: var(--font-weight-bold);
                    font-size: var(--font-size-small);
                    margin-bottom: var(--space-2xs);
                }

                .nav-title {
                    text-decoration: underline;
                    transition: color var(--transition-normal);
                }

                &:hover .nav-title {
                    color: var(--color-accent-500);
                }
            }

            .post-nav-link:first-child:not(:last-child) {
                border-right: 1px solid var(--color-neutral-600);
            }

            .post-nav-prev {
                text-align: end;
            }
        }
    }

    .publication-dates {
        display: flex;
        justify-content: center;
        gap: var(--space-xs);
        font-size: var(--font-size-small);
        color: var(--color-neutral-300);
        margin-top: var(--space-m);
        text-align: center;
    }

    @media only screen and (max-width: 580px) {
        .publication-dates {
            flex-direction: column;
            align-items: center;
            gap: 0;

            .date-separator {
                display: none;
            }
        }
    }

    @media only screen and (max-width: 580px) {
        .end-of-post-container {
            width: 100vw;
            margin-left: calc(-50vw + 50%);
            border-radius: 0;
            border-left: none;
            border-right: none;

            .post-nav-container {
                flex-direction: column;

                .post-nav-link:first-child:not(:last-child) {
                    border-right: none;
                    border-bottom: 1px solid var(--color-neutral-600);
                }
            }
        }
    }
    
    .sub-menu-container {
        padding-top: var(--space-2xs);

        .back-button {
            cursor: pointer;
            border: none;
            background-color: var(--color-neutral-900);
            color: var(--color-neutral-300);
            border-radius: var(--border-radius-s);

            &:hover, &:focus {
                background-color: var(--color-neutral-700);
            }
        }
    }

    .aside-container-right {
        width: 450px;
    }

    @media only screen and (max-width: 36rem) {
        h1 {
            font-size: 36px;
        }
    }

    @media only screen and (width >= 75rem) {
		.toc {
			width: 100%;
            max-width: 430px;
            margin-left: 16px;
            height: 100%;
		}
		.toc-icon {
			display: none;
			padding: 0;
			margin: 0;
		}
		.sticky-element {
			position: sticky;
			top: var(--navbar-height);
			z-index: 10;
			width: 100%;
			padding: 1rem;
		}
	}
    @media only screen and (width < 75rem) {
        .content-and-toc {
            flex-direction: column;
        }

        .main-container {
            margin-inline: auto;
        }

		.toc {
			display: contents;
		}

		.toc-icon {
			position: fixed;
			top: calc(var(--navbar-height) / 2);
			translate: 0 -50%;
			right: 3rem;
			display: block;
			cursor: pointer;
			padding: var(--space-2xs);
			border: none;
			background-color: transparent;
			border-radius: var(--border-radius-m);
			transition: background-color var(--transition-normal);
			z-index: 21;
            color: var(--color-neutral-300);
		}

		.toc-icon:hover,
		.toc-icon:focus-within {
			background-color: var(--color-neutral-800);
		}
		.toc-icon svg {
			transition: transform var(--transition-normal);
		}

		.toc-icon[aria-expanded="true"] svg {
			transform: rotate(90deg);
		}

		.toc-items {
			position: fixed;
			top: calc(var(--navbar-height) + var(--space-2xs));
			right: 0;
			display: none;
			max-height: calc(100svh - var(--navbar-height) - 75px);
			overflow-y: auto;
			background-color: var(--color-neutral-800);
			border-radius: var(--border-radius-m) 0 0 var(--border-radius-m);
			padding: var(--space-m);
			box-shadow: var(--box-shadow-m);
			min-width: 200px;
			max-width: calc(100vw - var(--space-xl));
			z-index: 99;
		}

		.toc-icon[aria-expanded="true"] + .toc-items {
			display: block;
			animation: slideInFromRight 0.2s ease-out;
		}
	}  
</style>

<script>
    // With the ClientRouter this script re-executes whenever navigation enters a
    // blog page from a page that doesn't include it, so guard the registration.
    const w = window as Window & { tocToggleInit?: boolean };
    if (!w.tocToggleInit) {
        w.tocToggleInit = true;
        document.addEventListener("click", (event) => {
            const tocToggle = document.querySelector(".toc-icon");
            if (!tocToggle || !(event.target instanceof Element)) return;

            if (tocToggle.contains(event.target)) {
                const isExpanded = tocToggle.getAttribute("aria-expanded") === "true";
                tocToggle.setAttribute("aria-expanded", (!isExpanded).toString());
                return;
            }

            const tocItems = document.querySelector(".toc-items");
            const keepOpen = tocItems?.contains(event.target) && !event.target.closest("a");
            if (!keepOpen) tocToggle.setAttribute("aria-expanded", "false");
        }, { capture: true });
    }
</script>
