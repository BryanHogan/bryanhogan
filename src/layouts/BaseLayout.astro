---
import "../styles/reset.css";
import "../styles/var.css";
import "../styles/global.css";
import "../styles/util.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import { ClientRouter } from "astro:transitions";
import { markdownPaths } from "../utils/markdown";

interface Props {
    title: string;
    description: string;
    canonical?: string;
    markdownHref?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
    articlePublished?: Date;
    articleModified?: Date;
    articleTags?: string[];
    robots?: string;
    author?: string;
}

const { 
    title, 
    description, 
    canonical,
    ogTitle,
    ogDescription,
    ogImage,
    ogImageAlt,
    ogType = "website",
    articlePublished,
    articleModified,
    articleTags,
    robots,
    author
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "");
const markdownHref = Astro.props.markdownHref ??
    (markdownPaths.includes(pathname.slice(1)) ? `${pathname}.md` : undefined);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <SEOHead 
            title={title}
            description={description}
            canonical={canonical}
            ogTitle={ogTitle}
            ogDescription={ogDescription}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            ogType={ogType}
            articlePublished={articlePublished}
            articleModified={articleModified}
            articleTags={articleTags}
            robots={robots}
            author={author}
        />
        <link rel="icon" href="/favicon.ico">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml">
        {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
        <meta name="theme-color" content="#A594D3">
        <link rel="alternate" type="application/rss+xml" title="Blog posts by Bryan Hogan" href={new URL("rss.xml", Astro.site)} />
        <script is:inline defer src="https://stats.bryanhogan.me/script.js" data-website-id="cdeb4dc4-f18c-4075-b157-bef3c25bb407" data-domains="bryanhogan.com"></script>
        <ClientRouter />
        <slot name="head"/>
      </head>
    <body>
        <Header />
        <div class="height-smart-fill-screen">
		    <div class="base-layout">
                <slot />
		    </div>
        </div>
        <Footer markdownHref={markdownHref} />
    </body>
</html>

<style is:global>
</style>
